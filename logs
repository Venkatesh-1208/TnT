### Change G — After the default `request_routing_rule` block (around line 372)

**FIND this block (lines 365–372):**
```hcl
  request_routing_rule {
    name                       = "default-rule-${local.appgw_name}"
    rule_type                  = var.appgw_request_routing_rule.rule_type
    http_listener_name         = "listener-default-${local.appgw_name}"
    backend_address_pool_name  = "default_bep-${local.appgw_name}"
    backend_http_settings_name = "bep-default-${local.appgw_name}"
    priority                   = var.appgw_request_routing_rule.priority
  }
```

**REPLACE WITH (keep original + add 4 new dynamic blocks after it):**
```hcl
  request_routing_rule {
    name                       = "default-rule-${local.appgw_name}"
    rule_type                  = var.appgw_request_routing_rule.rule_type
    http_listener_name         = "listener-default-${local.appgw_name}"
    backend_address_pool_name  = "default_bep-${local.appgw_name}"
    backend_http_settings_name = "bep-default-${local.appgw_name}"
    priority                   = var.appgw_request_routing_rule.priority
  }

  # ArgoCD backend address pool — AGIC will populate the IP addresses after first apply
  dynamic "backend_address_pool" {
    for_each = local.argocd_listener_list
    content {
      name = "bep-argocd-${local.appgw_name}"
    }
  }

  # ArgoCD backend HTTP settings — targets ArgoCD server on port 443 internally
  dynamic "backend_http_settings" {
    for_each = local.argocd_listener_list
    content {
      name                  = "bhs-argocd-${local.appgw_name}"
      cookie_based_affinity = "Disabled"
      port                  = 443
      protocol              = "Https"
      request_timeout       = 60
    }
  }

  # ArgoCD HTTPS → backend routing rule
  dynamic "request_routing_rule" {
    for_each = local.argocd_listener_list
    content {
      name                       = "rule-argocd-https-${local.appgw_name}"
      rule_type                  = "Basic"
      priority                   = 100
      http_listener_name         = "listener-argocd-https-${local.appgw_name}"
      backend_address_pool_name  = "bep-argocd-${local.appgw_name}"
      backend_http_settings_name = "bhs-argocd-${local.appgw_name}"
    }
  }

  # ArgoCD HTTP → HTTPS redirect routing rule
  dynamic "request_routing_rule" {
    for_each = local.argocd_listener_list
    content {
      name                        = "rule-argocd-http-redirect-${local.appgw_name}"
      rule_type                   = "Basic"
      priority                    = 110
      http_listener_name          = "listener-argocd-http-${local.appgw_name}"
      redirect_configuration_name = "redirect-argocd-http-to-https-${local.appgw_name}"
    }
  }

  # HTTP → HTTPS redirect configuration for ArgoCD
  dynamic "redirect_configuration" {
    for_each = local.argocd_listener_list
    content {
      name                 = "redirect-argocd-http-to-https-${local.appgw_name}"
      redirect_type        = "Permanent"
      target_listener_name = "listener-argocd-https-${local.appgw_name}"
      include_path         = true
      include_query_string = true
    }
  }
```


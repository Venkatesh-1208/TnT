### Change F — After line 332 (after the default `http_listener` block)

**FIND this block (lines 325–332):**
```hcl
  http_listener {
    name                           = "listener-default-${local.appgw_name}"
    frontend_ip_configuration_name = "Private"
    frontend_port_name             = "frontend-port-${local.appgw_name}"
    protocol                       = "Https"
    host_name                      = local.appgw_name
    ssl_certificate_name           = local.appgw_name
  }
```

**REPLACE WITH (keep the original + add two new dynamic blocks after it):**
```hcl
  http_listener {
    name                           = "listener-default-${local.appgw_name}"
    frontend_ip_configuration_name = "Private"
    frontend_port_name             = "frontend-port-${local.appgw_name}"
    protocol                       = "Https"
    host_name                      = local.appgw_name
    ssl_certificate_name           = local.appgw_name
  }

  # ArgoCD HTTPS listener — terminated at the gateway using the ArgoCD KV certificate
  dynamic "http_listener" {
    for_each = local.argocd_listener_list
    content {
      name                           = "listener-argocd-https-${local.appgw_name}"
      frontend_ip_configuration_name = "Private"
      frontend_port_name             = "frontend-port-${local.appgw_name}"
      protocol                       = "Https"
      host_name                      = http_listener.value
      ssl_certificate_name           = local.argocd_cert_name
    }
  }

  # ArgoCD HTTP listener — receives plain-text traffic and redirects to HTTPS
  dynamic "http_listener" {
    for_each = local.argocd_listener_list
    content {
      name                           = "listener-argocd-http-${local.appgw_name}"
      frontend_ip_configuration_name = "Private"
      frontend_port_name             = "frontend-port-http-${local.appgw_name}"
      protocol                       = "Http"
      host_name                      = http_listener.value
    }
  }
```

